NEXT_PUBLIC_APP_NAME="AmanahZakat Peduli"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# api = panggil backend (wajib untuk uji signed QR BSZ)
NEXT_PUBLIC_DATA_MODE="mock"
NEXT_PUBLIC_API_BASE_URL="http://localhost:5005/api/v1/public"
# Origin backend untuk rewrite /uploads (production: http://127.0.0.1:5005 atau URL internal)
BACKEND_INTERNAL_URL="http://localhost:5005"
NEXT_PUBLIC_ENABLE_DEMO_PAYMENT_CONTROLS="true"
NEXT_PUBLIC_ENABLE_MOCK_ZIS_ASSISTANT="true"
